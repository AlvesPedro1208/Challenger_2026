name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  checks:
    name: Lint, typecheck e testes
    runs-on: ubunto-latest
    defaults:
      run:
        working-directory: projeto
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: projeto/package-lock.json

      - run: npm ci --no-audit --no-found

      - run: npm run typecheck

      - run: npm run lint

      - run: npm test